    { "source": "/es/proyectos/zaplink/", "destination": "/es/proyectos/yepkey/", "permanent": true },
    { "source": "/en/projects/zaplink", "destination": "/en/projects/yepkey/", "permanent": true },
    { "source": "/en/projects/zaplink/", "destination": "/en/projects/yepkey/", "permanent": true }
