---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { t, type Locale } from '../i18n';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  /** Path on the *other* locale that maps to the current page (for the language toggle). */
  altLocaleHref?: string;
  /** Emit `<meta name="robots" content="noindex, nofollow">`. Use for draft posts. */
  noindex?: boolean;
  /** Path to the OG image (e.g. `/og/writing/slug.png`). Falls back to `/og-image.png`. */
  ogImage?: string;
  /** og:type — use `'article'` for blog posts. Defaults to `'website'`. */
  type?: 'website' | 'article';
  /** ISO date for `article:published_time`. Only rendered when `type='article'`. */
  articleDate?: Date;
  /** Values for `article:tag`. Only rendered when `type='article'`. */
  articleTags?: string[];
}

const { locale, title, description, altLocaleHref, noindex = false, ogImage, type = 'website', articleDate, articleTags } = Astro.props;
const dict = t(locale);
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = ogImage ? new URL(ogImage, Astro.site).toString() : new URL('/og-image.png', Astro.site).toString();
const ogLocale = locale === 'es' ? 'es_MX' : 'en_US';
---

<!doctype html>
<html lang={locale === 'es' ? 'es-MX' : 'en-US'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical.toString()} />
    <link rel="icon" type="image/svg+xml" href="/logos/hecsanchez.svg" />

    <link rel="preconnect" href="https://use.typekit.net" crossorigin />
    <link rel="stylesheet" href="https://use.typekit.net/ujh3wif.css" />

    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical.toString()} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:site_name" content={dict.siteName} />
    <meta property="og:locale" content={ogLocale} />
    {type === 'article' && articleDate && (
      <meta property="article:published_time" content={articleDate.toISOString()} />
    )}
    {type === 'article' && articleTags?.map(tag => (
      <meta property="article:tag" content={tag} />
    ))}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    {altLocaleHref && (
      <link
        rel="alternate"
        hreflang={locale === 'es' ? 'en' : 'es'}
        href={new URL(altLocaleHref, Astro.site).toString()}
      />
    )}
    <link rel="alternate" hreflang={locale} href={canonical.toString()} />

    <!-- Privacy-friendly analytics by Plausible -->
    <script async src="https://plausible.io/js/pa-LLj1kLisNbG0bzRIrzcq1.js"></script>
    <script>
      window.plausible=window.plausible||function(){(plausible.q=plausible.q||[]).push(arguments)},plausible.init=plausible.init||function(i){plausible.o=i||{}};
      plausible.init()
    </script>
  </head>
  <body class="flex min-h-dvh flex-col">
    <Nav locale={locale} altLocaleHref={altLocaleHref} />
    <main class="flex-1">
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>
