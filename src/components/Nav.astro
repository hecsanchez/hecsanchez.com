---
import { t, type Locale } from '../i18n';
import LanguageToggle from './LanguageToggle.astro';

interface Props {
  locale: Locale;
  altLocaleHref?: string;
}

const { locale, altLocaleHref } = Astro.props;
const dict = t(locale);
const r = dict.routes;

const links = [
  { href: r.howIWork, label: dict.nav.howIWork },
  { href: r.about, label: dict.nav.about },
  { href: r.blog, label: dict.nav.blog },
];
---

<header class="border-b border-[var(--color-border)]">
  <div class="mx-auto flex max-w-5xl items-center justify-between px-6 py-5">
    <a
      href={r.home}
      class="block shrink-0"
      aria-label="Hec Sánchez — home"
    >
      <img
        src="/logos/hecsanchez.svg"
        alt="Hec Sánchez"
        width="348"
        height="240"
        class="h-6 w-auto"
      />
    </a>

    <nav class="hidden items-center gap-7 text-sm md:flex">
      {links.map((link) => (
        <a href={link.href} class="text-[var(--color-fg-muted)] transition hover:text-[var(--color-fg)]">
          {link.label}
        </a>
      ))}
      <LanguageToggle locale={locale} altLocaleHref={altLocaleHref} />
      <a
        href={r.contact}
        class="rounded-full bg-[var(--color-accent)] px-4 py-2 text-sm font-medium text-[var(--color-bg)] transition hover:bg-[var(--color-accent-hover)] hover:text-[var(--color-bg)]"
      >
        {dict.nav.contact}
      </a>
    </nav>

    <button
      id="mobile-nav-toggle"
      type="button"
      class="md:hidden text-[var(--color-fg)]"
      aria-label="Menu"
      aria-expanded="false"
      aria-controls="mobile-nav"
    >
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
        <line x1="4" y1="7" x2="20" y2="7" />
        <line x1="4" y1="12" x2="20" y2="12" />
        <line x1="4" y1="17" x2="20" y2="17" />
      </svg>
    </button>
  </div>

  <div
    id="mobile-nav"
    class="hidden md:hidden border-t border-[var(--color-border)] bg-[var(--color-bg)]"
  >
    <nav class="mx-auto flex max-w-5xl flex-col gap-1 px-6 py-4 text-base">
      {links.map((link) => (
        <a href={link.href} class="py-3 text-[var(--color-fg-muted)] hover:text-[var(--color-fg)]">
          {link.label}
        </a>
      ))}
      <a
        href={r.contact}
        class="mt-2 inline-block rounded-full bg-[var(--color-accent)] px-4 py-3 text-center text-sm font-medium text-[var(--color-bg)] hover:text-[var(--color-bg)]"
      >
        {dict.nav.contact}
      </a>
      <div class="mt-3"><LanguageToggle locale={locale} altLocaleHref={altLocaleHref} /></div>
    </nav>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-nav-toggle');
  const menu = document.getElementById('mobile-nav');
  if (btn && menu) {
    btn.addEventListener('click', () => {
      const open = menu.classList.toggle('hidden') === false;
      btn.setAttribute('aria-expanded', String(open));
    });
  }
</script>
