---
import { type Locale } from '../i18n';

interface Props {
  locale: Locale;
  altLocaleHref?: string;
}

const { locale, altLocaleHref } = Astro.props;
const otherLocale: Locale = locale === 'es' ? 'en' : 'es';
const fallback = otherLocale === 'es' ? '/es' : '/en';
const href = altLocaleHref ?? fallback;
---

<div class="flex items-center gap-1 text-xs uppercase tracking-wider text-[var(--color-fg-dim)]">
  <span class={locale === 'es' ? 'text-[var(--color-fg)]' : ''}>
    {locale === 'es' ? 'ES' : <a href={href}>ES</a>}
  </span>
  <span aria-hidden="true">/</span>
  <span class={locale === 'en' ? 'text-[var(--color-fg)]' : ''}>
    {locale === 'en' ? 'EN' : <a href={href}>EN</a>}
  </span>
</div>
