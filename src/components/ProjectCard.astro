---
import type { Locale } from '../i18n';

interface Props {
  href: string;
  name: string;
  summary: string;
  stack: string[];
  locale: Locale;
}

const { href, name, summary, stack } = Astro.props;
---

<a
  href={href}
  class="group block rounded-2xl border border-[var(--color-border)] bg-[var(--color-bg-soft)] p-7 transition hover:border-[var(--color-accent)]"
>
  <h3 class="font-serif text-2xl text-[var(--color-fg)] group-hover:text-[var(--color-accent)]">{name}</h3>
  <p class="mt-3 text-[var(--color-fg-muted)]">{summary}</p>
  <div class="mt-5 flex flex-wrap gap-2">
    {stack.slice(0, 4).map((s) => (
      <span class="rounded-full border border-[var(--color-border)] px-2.5 py-0.5 text-xs text-[var(--color-fg-dim)]">
        {s}
      </span>
    ))}
  </div>
</a>
