---
import { t, type Locale } from '../i18n';
import { projectHref, type Project } from '../data/projects';
import { resolveProjectImage } from '../lib/projectImages';

interface Props {
  locale: Locale;
  project: Project;
  /** Overrides the card description — audience pages use their own wording. */
  description?: string;
}

const { locale, project, description } = Astro.props;
const dict = t(locale);
const href = projectHref(dict.routes.projects, project.id);

// Cards preview the hero. Missing file, no image — the card still works.
const preview = resolveProjectImage(project.hero?.file);
---

<a
  href={href}
  class="group flex flex-col rounded-2xl border border-[var(--color-border)] bg-[var(--color-bg-soft)] p-7 transition hover:border-[var(--color-accent)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-accent)]"
  data-analytics-event="project_link_click"
  data-analytics-props={JSON.stringify({ project: project.id, destination_type: 'detail', locale })}
>
  {preview && project.hero && (
    <img
      src={preview.src}
      alt={project.hero.alt[locale]}
      width={preview.width}
      height={preview.height}
      loading="lazy"
      decoding="async"
      class="mb-5 aspect-[16/10] w-full rounded-lg border border-[var(--color-border)] object-cover object-top"
    />
  )}
  <div class="text-xs uppercase tracking-[0.15em] text-[var(--color-fg-dim)]">
    {project.category[locale]}
  </div>
  <h3 class="mt-2 font-serif text-2xl group-hover:text-[var(--color-accent)]">
    {project.title[locale]}
  </h3>
  <p class="mt-3 text-base text-[var(--color-fg-muted)]">
    {description ?? project.cardDescription[locale]}
  </p>
</a>
