---
import { t, type Locale } from '../i18n';

interface Props {
  locale: Locale;
  variant?: 'primary' | 'block';
}

const { locale, variant = 'primary' } = Astro.props;
const dict = t(locale);
---

{variant === 'primary' ? (
  <a
    href={dict.routes.contact}
    class="inline-flex items-center gap-2 rounded-full bg-[var(--color-accent)] px-6 py-3 font-medium text-[var(--color-bg)] transition hover:bg-[var(--color-accent-hover)] hover:text-[var(--color-bg)]"
  >
    {dict.cta.primary}
    <span aria-hidden="true">→</span>
  </a>
) : (
  <section class="mx-auto mt-24 max-w-3xl rounded-2xl border border-[var(--color-border)] bg-[var(--color-bg-soft)] px-8 py-12 text-center">
    <h2 class="font-serif text-3xl">{dict.cta.ready}</h2>
    <p class="mt-3 text-[var(--color-fg-muted)]">{dict.home.valueProp}</p>
    <div class="mt-6">
      <a
        href={dict.routes.contact}
        class="inline-flex items-center gap-2 rounded-full bg-[var(--color-accent)] px-6 py-3 font-medium text-[var(--color-bg)] transition hover:bg-[var(--color-accent-hover)] hover:text-[var(--color-bg)]"
      >
        {dict.cta.primary}
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>
)}
