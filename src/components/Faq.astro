---
interface Props {
  title: string;
  items: readonly { q: string; a: string }[];
}

const { title, items } = Astro.props;
---

<section class="mx-auto max-w-3xl px-6 py-14">
  <h2 class="font-serif text-3xl">{title}</h2>
  <div class="mt-8 divide-y divide-[var(--color-border)]">
    {items.map((item) => (
      <div class="py-6">
        <h3 class="font-serif text-xl">{item.q}</h3>
        <p class="mt-3 text-[var(--color-fg-muted)]">{item.a}</p>
      </div>
    ))}
  </div>
</section>
