---
import { t, type Locale, testimonials, companies } from '../../i18n';
import CTA from '../CTA.astro';
import TestimonialCard from '../TestimonialCard.astro';

interface Props { locale: Locale }
const { locale } = Astro.props;
const dict = t(locale);
---

<!-- Hero -->
<section class="mx-auto max-w-5xl px-6 pt-20 pb-16 md:pt-32 md:pb-24">
  <h1 class="text-sm uppercase tracking-[0.18em] text-[var(--color-accent)]">
    {dict.home.heroSubtitle}
  </h1>
  <p class="mt-4 font-serif text-5xl leading-[1.05] md:text-7xl">
    {dict.home.heroTitle}
  </p>
  <p class="mt-8 max-w-2xl font-serif leading-relaxed text-[var(--color-fg-muted)]">
    {dict.home.valueProp}
  </p>
  <div class="mt-10 flex flex-wrap items-center gap-5">
    <CTA locale={locale} />
    <a
      href={dict.routes.howIWork}
      class="text-sm text-[var(--color-fg-muted)] underline underline-offset-4 hover:text-[var(--color-fg)]"
    >
      {dict.cta.secondary} →
    </a>
  </div>
</section>

<!-- Social proof -->
<section class="border-y border-[var(--color-border)] bg-[var(--color-bg-soft)]/40">
  <div class="mx-auto max-w-5xl px-6 py-10">
    <p class="text-xs uppercase tracking-[0.18em] text-[var(--color-fg-dim)]">
      {dict.home.socialProofTitle}
    </p>
    <ul class="mt-5 flex flex-wrap items-center gap-x-10 gap-y-4">
      {companies.map((c) => (
        <li class="font-serif text-lg text-[var(--color-fg-muted)] transition hover:text-[var(--color-fg)]">
          {c}
        </li>
      ))}
    </ul>
    <!-- TODO: Hec to provide SVG logos in /public/logos/. Replace text with <img> tags. -->
  </div>
</section>

<!-- What I do -->
<section class="mx-auto max-w-5xl px-6 py-20">
  <h2 class="font-serif text-3xl md:text-4xl">{dict.home.whatIDoTitle}</h2>
  <div class="mt-10 grid gap-6 md:grid-cols-3">
    <article class="rounded-2xl border border-[var(--color-border)] bg-[var(--color-bg-soft)] p-7">
      <div class="mb-5 inline-flex h-10 w-10 items-center justify-center rounded-lg bg-[var(--color-bg-elevated)] text-[var(--color-accent)]">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M12 2 4 7v6c0 4.5 3.5 8 8 9 4.5-1 8-4.5 8-9V7l-8-5z"/></svg>
      </div>
      <h3 class="font-serif text-2xl">{dict.home.cards.strategyTitle}</h3>
      <p class="mt-3 text-[var(--color-fg-muted)] text-base">{dict.home.cards.strategyDesc}</p>
    </article>
    <article class="rounded-2xl border border-[var(--color-border)] bg-[var(--color-bg-soft)] p-7">
      <div class="mb-5 inline-flex h-10 w-10 items-center justify-center rounded-lg bg-[var(--color-bg-elevated)] text-[var(--color-accent)]">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><circle cx="9" cy="8" r="3"/><circle cx="17" cy="9" r="2.5"/><path d="M3 19c0-3 3-5 6-5s6 2 6 5"/><path d="M15 19c0-2 2-4 4-4"/></svg>
      </div>
      <h3 class="font-serif text-2xl">{dict.home.cards.leadershipTitle}</h3>
      <p class="mt-3 text-[var(--color-fg-muted)] text-base">{dict.home.cards.leadershipDesc}</p>
    </article>
    <article class="rounded-2xl border border-[var(--color-border)] bg-[var(--color-bg-soft)] p-7">
      <div class="mb-5 inline-flex h-10 w-10 items-center justify-center rounded-lg bg-[var(--color-bg-elevated)] text-[var(--color-accent)]">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="m8 9-4 3 4 3"/><path d="m16 9 4 3-4 3"/><path d="m13 5-2 14"/></svg>
      </div>
      <h3 class="font-serif text-2xl">{dict.home.cards.executionTitle}</h3>
      <p class="mt-3 text-[var(--color-fg-muted)] text-base">{dict.home.cards.executionDesc}</p>
    </article>
  </div>
</section>

<!-- Bio -->
<section class="mx-auto max-w-3xl px-6 py-12">
  <p class="font-serif text-2xl leading-relaxed text-[var(--color-fg)] md:text-3xl">
    {dict.home.bio}
  </p>
</section>

<!-- Testimonials -->
<section class="mx-auto max-w-5xl px-6 py-20">
  <h2 class="font-serif text-3xl md:text-4xl">{dict.home.testimonialsTitle}</h2>
  <div class="mt-10 grid gap-6 md:grid-cols-2">
    {testimonials.map((tm) => (
      <TestimonialCard
        quote={tm.quote[locale]}
        name={tm.name}
        title={tm.title[locale]}
        company={tm.company}
        locale={locale}
      />
    ))}
  </div>
</section>

<!-- Bottom CTA -->
<div class="px-6 pb-20">
  <CTA locale={locale} variant="block" />
</div>
