---
import { getCollection } from 'astro:content';
import { t, type Locale } from '../../i18n';
import { publishedProjects } from '../../data/projects';
import ArrowLink from '../ArrowLink.astro';
import ProjectCard from '../ProjectCard.astro';
import SubscribeForm from '../SubscribeForm.astro';

interface Props { locale: Locale }
const { locale } = Astro.props;
const dict = t(locale);

const featured = publishedProjects.filter((p) => p.featured);

// At most three previews, newest first. Renders whatever is actually published.
const posts = (await getCollection('blog', ({ data }) => !data.draft && data.locale === locale))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);

const dateFmt = new Intl.DateTimeFormat(locale === 'es' ? 'es-MX' : 'en-US', {
  year: 'numeric', month: 'short', day: 'numeric',
  // Dates are authored as plain days; format them in UTC so the build
  // machine's timezone cannot shift them to the day before.
  timeZone: 'UTC',
});
---

<!-- Hero -->
<section class="mx-auto max-w-5xl px-6 pt-20 pb-16 md:pt-28 md:pb-24">
  <div class="flex flex-col gap-10 md:flex-row-reverse md:items-start md:gap-16">
    <img
      src="/hecsanchez.png"
      alt="Hec Sánchez"
      width="240"
      height="240"
      class="h-40 w-40 shrink-0 rounded-full object-cover md:mt-3 md:h-60 md:w-60"
    />
    <div class="md:flex-1">
      <p class="text-sm uppercase tracking-[0.18em] text-[var(--color-accent)]">{dict.tagline}</p>
      <h1 class="mt-6 font-serif text-3xl leading-[1.15] text-balance text-[var(--color-fg)] md:text-5xl">
        {dict.home.h1}
      </h1>
      {dict.home.intro.map((paragraph) => (
        <p class="mt-4 max-w-[52ch] leading-relaxed text-[var(--color-fg-muted)]">{paragraph}</p>
      ))}
      <div class="mt-10 flex flex-wrap items-center gap-5">
        <a
          href={dict.routes.projects}
          class="inline-flex items-center gap-2 rounded-full bg-[var(--color-accent)] px-6 py-3 font-medium text-[var(--color-bg)] transition hover:bg-[var(--color-accent-hover)] hover:text-[var(--color-bg)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-accent)]"
        >
          {dict.cta.exploreMyWork}
          <span aria-hidden="true">→</span>
        </a>
        <ArrowLink href="#work-with-me">{dict.cta.workWithMe}</ArrowLink>
      </div>
    </div>
  </div>
</section>

<!-- Selected work -->
<section class="mx-auto max-w-5xl px-6 py-20">
  <h2 class="font-serif text-3xl md:text-4xl">{dict.home.workTitle}</h2>
  <p class="mt-4 max-w-[64ch] text-[var(--color-fg-muted)]">{dict.home.workIntro}</p>
  <div class="mt-10 grid gap-6 md:grid-cols-3">
    {featured.map((project) => <ProjectCard locale={locale} project={project} />)}
  </div>
  <p class="mt-8">
    <ArrowLink href={dict.routes.projects}>{dict.cta.seeAllProjects}</ArrowLink>
  </p>
</section>

<!-- Two ways to work together -->
<section id="work-with-me" class="border-y border-[var(--color-border)] bg-[var(--color-bg-soft)]/40 scroll-mt-16">
  <div class="mx-auto max-w-5xl px-6 py-20">
    <h2 class="font-serif text-3xl md:text-4xl">{dict.home.workWithMeTitle}</h2>
    <div class="mt-10 grid gap-6 md:grid-cols-2">
      <article class="rounded-2xl border border-[var(--color-border)] bg-[var(--color-bg-soft)] p-8">
        <h3 class="font-serif text-2xl">{dict.home.agenciesTitle}</h3>
        <p class="mt-3 text-[var(--color-fg-muted)]">{dict.home.agenciesBody}</p>
        <p class="mt-6">
          <ArrowLink
            href={dict.routes.agencies}
            event="service_cta_click"
            analyticsProps={{ audience: 'agency', locale, placement: 'home_cards' }}
          >
            {dict.cta.exploreAgencySupport}
          </ArrowLink>
        </p>
      </article>
      <article class="rounded-2xl border border-[var(--color-border)] bg-[var(--color-bg-soft)] p-8">
        <h3 class="font-serif text-2xl">{dict.home.foundersTitle}</h3>
        <p class="mt-3 text-[var(--color-fg-muted)]">{dict.home.foundersBody}</p>
        <p class="mt-6">
          <ArrowLink
            href={dict.routes.founders}
            event="service_cta_click"
            analyticsProps={{ audience: 'founder', locale, placement: 'home_cards' }}
          >
            {dict.cta.exploreFounderSupport}
          </ArrowLink>
        </p>
      </article>
    </div>
  </div>
</section>

<!-- Latest writing -->
<section class="mx-auto max-w-5xl px-6 py-20">
  <h2 class="font-serif text-3xl md:text-4xl">{dict.home.writingTitle}</h2>
  <p class="mt-4 max-w-[64ch] text-[var(--color-fg-muted)]">{dict.home.writingIntro}</p>

  {posts.length > 0 ? (
    <ul class="mt-10 divide-y divide-[var(--color-border)] border-t border-[var(--color-border)]">
      {posts.map((post) => (
        <li class="py-6">
          <a href={`${dict.routes.blog}/${post.id.replace(/\.mdx?$/, '')}`} class="group block">
            <div class="text-xs uppercase tracking-[0.15em] text-[var(--color-fg-dim)]">
              {dateFmt.format(post.data.date)}
            </div>
            <h3 class="mt-2 font-serif text-2xl group-hover:text-[var(--color-accent)]">{post.data.title}</h3>
            <p class="mt-2 text-[var(--color-fg-muted)]">{post.data.description}</p>
          </a>
        </li>
      ))}
    </ul>
  ) : (
    <p class="mt-10 text-[var(--color-fg-muted)]">{dict.blog.empty}</p>
  )}

  <p class="mt-8">
    <ArrowLink href={dict.routes.blog}>{dict.cta.readAllArticles}</ArrowLink>
  </p>
</section>

<SubscribeForm locale={locale} placement="home" />
