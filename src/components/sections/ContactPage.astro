---
import { t, type Locale, contactInfo } from '../../i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;
const dict = t(locale);
---

<section class="mx-auto max-w-3xl px-6 pt-20 pb-10">
  <h1 class="font-serif text-5xl md:text-6xl">{dict.contact.title}</h1>
  <p class="mt-6 font-serif text-[var(--color-fg-muted)]">{dict.contact.subtext}</p>
</section>

<section class="mx-auto max-w-4xl px-6 pb-12">
  <!-- Cal.com inline embed. TODO: Hec to confirm calLink in src/i18n/index.ts -->
  <div
    id="cal-inline"
    class="rounded-2xl border border-[var(--color-border)] overflow-hidden bg-[var(--color-bg-soft)]"
    style="min-width:320px;min-height:680px;width:100%;"
  ></div>
  <script type="text/javascript" is:inline define:vars={{ calLink: contactInfo.calLink }}>
    (function (C, A, L) {
      let p = function (a, ar) { a.q.push(ar); };
      let d = C.document;
      C.Cal = C.Cal || function () {
        let cal = C.Cal;
        let ar = arguments;
        if (!cal.loaded) {
          cal.ns = {};
          cal.q = cal.q || [];
          d.head.appendChild(d.createElement('script')).src = A;
          cal.loaded = true;
        }
        if (ar[0] === L) {
          const api = function () { p(api, arguments); };
          const namespace = ar[1];
          api.q = api.q || [];
          if (typeof namespace === 'string') {
            cal.ns[namespace] = cal.ns[namespace] || api;
            p(cal.ns[namespace], ar);
            p(cal, ['initNamespace', namespace]);
          } else {
            p(cal, ar);
          }
          return;
        }
        p(cal, ar);
      };
    })(window, 'https://app.cal.com/embed/embed.js', 'init');

    Cal('init', 'booking', { origin: 'https://cal.com' });
    Cal.ns.booking('inline', {
      elementOrSelector: '#cal-inline',
      calLink: calLink,
      config: { layout: 'month_view' },
    });
    Cal.ns.booking('ui', {
      theme: 'light',
      cssVarsPerTheme: {
        light: {
          'cal-bg': '#f5efe6',
          'cal-bg-emphasis': '#ede5d6',
          'cal-bg-muted': '#e2d8c5',
          'cal-brand': '#7a1f2b',
          'cal-text': '#2a1f26',
          'cal-text-emphasis': '#2a1f26',
          'cal-border': '#d9cfc0',
        },
      },
      hideEventTypeDetails: false,
      layout: 'month_view',
    });
  </script>
</section>

<section class="mx-auto max-w-3xl px-6 pb-20">
  <p class="text-[var(--color-fg-muted)]">
    {dict.contact.altTitle}
    {' → '}
    <a href={`mailto:${contactInfo.email}`} class="text-[var(--color-accent)] underline underline-offset-4">{contactInfo.email}</a>
  </p>
  <p class="mt-3">
    <a href={contactInfo.linkedin} target="_blank" rel="noopener" class="text-[var(--color-accent)] underline underline-offset-4">{dict.contact.linkedinLabel}</a>
  </p>
</section>
