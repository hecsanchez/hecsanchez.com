---
import { t, type Locale, contactInfo } from '../../i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;
const dict = t(locale);
---

<section class="mx-auto max-w-3xl px-6 pt-20 pb-10">
  <h1 class="font-serif text-5xl md:text-6xl">{dict.contact.title}</h1>
  <p class="mt-6 font-serif text-xl text-[var(--color-fg-muted)]">{dict.contact.subtext}</p>
</section>

<section class="mx-auto max-w-4xl px-6 pb-12">
  <!-- Calendly inline embed. TODO: Hec to confirm the URL in src/i18n/index.ts -->
  <div
    class="calendly-inline-widget rounded-2xl border border-[var(--color-border)] overflow-hidden bg-[var(--color-bg-soft)]"
    data-url={`${contactInfo.calendly}?hide_landing_page_details=1&hide_gdpr_banner=1&background_color=332731&text_color=f5f0f3&primary_color=d4a843`}
    style="min-width:320px;height:680px;"
  ></div>
  <script async src="https://assets.calendly.com/assets/external/widget.js"></script>
</section>

<section class="mx-auto max-w-3xl px-6 pb-20">
  <p class="text-[var(--color-fg-muted)]">
    {dict.contact.altTitle}
    {' → '}
    <a href={`mailto:${contactInfo.email}`} class="text-[var(--color-accent)] underline underline-offset-4">{contactInfo.email}</a>
  </p>
  <p class="mt-3">
    <a href={contactInfo.linkedin} target="_blank" rel="noopener" class="text-[var(--color-accent)] underline underline-offset-4">{dict.contact.linkedinLabel}</a>
  </p>
</section>
