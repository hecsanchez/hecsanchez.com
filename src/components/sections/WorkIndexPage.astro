---
import { getCollection } from 'astro:content';
import { t, type Locale } from '../../i18n';
import ProjectCard from '../ProjectCard.astro';
import CTA from '../CTA.astro';

interface Props { locale: Locale }
const { locale } = Astro.props;
const dict = t(locale);

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const base = dict.routes.work;
---

<section class="mx-auto max-w-5xl px-6 pt-20 pb-10">
  <h1 class="font-serif text-5xl md:text-6xl">{dict.work.title}</h1>
  <p class="mt-6 max-w-2xl font-serif text-[var(--color-fg-muted)]">{dict.work.intro}</p>
</section>

<section class="mx-auto max-w-5xl px-6 pb-20">
  <div class="grid gap-6 md:grid-cols-2">
    {projects.map((p) => (
      <ProjectCard
        href={`${base}/${p.id}`}
        name={p.data.name}
        summary={p.data.summary[locale]}
        stack={p.data.stack}
        locale={locale}
      />
    ))}
  </div>
</section>

<div class="px-6 pb-20">
  <CTA locale={locale} variant="block" />
</div>
