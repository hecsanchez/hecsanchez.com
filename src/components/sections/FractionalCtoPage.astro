---
import { t, type Locale } from '../../i18n';
import ArrowLink from '../ArrowLink.astro';

interface Props { locale: Locale }
const { locale } = Astro.props;
const dict = t(locale);
const fc = dict.fractionalCto;
---

<article class="mx-auto max-w-[758px] px-6 pt-20 pb-12">
  <header>
    <h1 class="font-serif text-4xl leading-tight md:text-5xl">{fc.h1}</h1>
  </header>

  <nav aria-labelledby="toc-title" class="mt-10 rounded-2xl border border-[var(--color-border)] bg-[var(--color-bg-soft)] p-6">
    <div id="toc-title" class="text-xs uppercase tracking-[0.18em] text-[var(--color-fg-dim)]">
      {fc.tocTitle}
    </div>
    <ol class="mt-4 space-y-2">
      {fc.toc.map((item) => (
        <li>
          <a
            href={`#${item.id}`}
            class="text-[var(--color-accent)] underline underline-offset-4 decoration-[var(--color-border)] hover:decoration-[var(--color-accent)]"
          >
            {item.label}
          </a>
        </li>
      ))}
    </ol>
  </nav>

  <div class="prose-post mt-12">
    {fc.intro.map((paragraph) => <p>{paragraph}</p>)}

    <section id="what-they-do" class="scroll-mt-16">
      <h2>{fc.whatTheyDo.title}</h2>
      {fc.whatTheyDo.body.map((p) => <p>{p}</p>)}
    </section>

    <section id="when-yes" class="scroll-mt-16">
      <h2>{fc.whenYes.title}</h2>
      {fc.whenYes.body.map((p) => <p>{p}</p>)}
    </section>

    <section id="when-no" class="scroll-mt-16">
      <h2>{fc.whenNo.title}</h2>
      {fc.whenNo.body.map((p) => <p>{p}</p>)}
    </section>

    <section id="comparison" class="scroll-mt-16">
      <h2>{fc.comparison.title}</h2>
      <div class="overflow-x-auto">
        <table class="w-full border-collapse text-left text-base">
          <thead>
            <tr class="border-b border-[var(--color-border)]">
              {fc.comparison.headers.map((header) => (
                <th scope="col" class="py-3 pr-6 font-sans text-sm font-semibold text-[var(--color-fg)]">{header}</th>
              ))}
            </tr>
          </thead>
          <tbody>
            {fc.comparison.rows.map((row) => (
              <tr class="border-b border-[var(--color-border)] align-top">
                <th scope="row" class="py-3 pr-6 font-sans text-sm font-medium text-[var(--color-fg)]">{row[0]}</th>
                <td class="py-3 font-sans text-sm text-[var(--color-fg-muted)]">{row[1]}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section id="fees" class="scroll-mt-16">
      <h2>{fc.fees.title}</h2>
      {fc.fees.body.map((p) => <p>{p}</p>)}
    </section>
  </div>
</article>

<aside class="mx-auto max-w-[758px] px-6 pb-20">
  <div class="rounded-2xl border border-[var(--color-border)] bg-[var(--color-bg-soft)] p-8">
    <h2 class="font-serif text-2xl">{fc.ctaTitle}</h2>
    <p class="mt-3 text-[var(--color-fg-muted)]">{fc.ctaBody}</p>
    <p class="mt-5">
      <ArrowLink
        href={dict.routes.founders}
        event="service_cta_click"
        analyticsProps={{ audience: 'founder', locale, placement: 'fractional_cto' }}
      >
        {dict.cta.exploreFounderSupport}
      </ArrowLink>
    </p>
  </div>
</aside>
