---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import { t, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
  post: CollectionEntry<'blog'>;
}

const { locale, post } = Astro.props;
const dict = t(locale);
const { Content } = await render(post);

const dateFmt = new Intl.DateTimeFormat(locale === 'es' ? 'es-MX' : 'en-US', {
  year: 'numeric', month: 'long', day: 'numeric',
});

const wordCount = post.body?.split(/\s+/).length ?? 0;
const readingTime = Math.max(1, Math.round(wordCount / 220));
---

<article class="mx-auto max-w-[758px] px-6 pt-20 pb-12">
  <a href={dict.routes.blog} class="text-sm text-[var(--color-fg-dim)] hover:text-[var(--color-fg)]">← {dict.nav.blog}</a>
  <header class="mt-8">
    <div class="text-xs uppercase tracking-[0.15em] text-[var(--color-fg-dim)]">
      {dateFmt.format(post.data.date)} · {readingTime} {dict.blog.readingTime} · {post.data.tags.join(', ')}
    </div>
    <h1 class="mt-4 font-serif text-4xl md:text-5xl leading-tight">{post.data.title}</h1>
    {post.data.description && (
      <p class="mt-4 font-serif text-[var(--color-fg-muted)]">{post.data.description}</p>
    )}
  </header>

  <div class="prose-post mt-12">
    <Content />
  </div>
</article>

<aside class="mx-auto max-w-[758px] px-6 pb-20">
  <div class="rounded-2xl border border-[var(--color-border)] bg-[var(--color-bg-soft)] p-8 text-center">
    <h2 class="font-serif text-2xl">{dict.blog.ctaTitle}</h2>
    <p class="mt-2 text-[var(--color-fg-muted)]">{dict.blog.ctaBody}</p>
    <a
      href={dict.routes.contact}
      class="mt-5 inline-flex items-center gap-2 rounded-full bg-[var(--color-accent)] px-5 py-2.5 font-medium text-[var(--color-bg)] hover:text-[var(--color-bg)]"
    >
      {dict.cta.primary} →
    </a>
  </div>
</aside>
