---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import { t, type Locale, contactInfo } from '../../i18n';
import SubscribeForm from '../SubscribeForm.astro';

interface Props {
  locale: Locale;
  post: CollectionEntry<'blog'>;
}

const { locale, post } = Astro.props;
const dict = t(locale);
const { Content } = await render(post);

const dateFmt = new Intl.DateTimeFormat(locale === 'es' ? 'es-MX' : 'en-US', {
  year: 'numeric', month: 'long', day: 'numeric',
});

const wordCount = post.body?.split(/\s+/).length ?? 0;
const readingTime = Math.max(1, Math.round(wordCount / 220));

const authorLink = post.data.linkedinUrl ?? contactInfo.linkedin;
const authorLinkLabel = locale === 'es' ? 'Continúa la conversación en LinkedIn' : 'Continue the conversation on LinkedIn';
---

<!-- Post header — wider, centered -->
<div class="mx-auto max-w-[1000px] px-6 pt-8 pb-0">
  <a href={dict.routes.blog} class="inline-block text-sm text-[var(--color-fg-dim)] hover:text-[var(--color-fg)]">← {dict.nav.blog}</a>

  {post.data.draft && (
    <div
      role="status"
      class="mt-6 flex justify-center"
    >
      <span class="inline-flex items-center gap-2 rounded-full border border-[var(--color-accent)] bg-[var(--color-bg-soft)] px-3 py-1 text-xs uppercase tracking-[0.18em] text-[var(--color-accent)]">
        <span class="inline-block h-1.5 w-1.5 rounded-full bg-[var(--color-accent)]" />
        {locale === 'es' ? 'Borrador — no listado' : 'Draft — unlisted'}
      </span>
    </div>
  )}
  <header class="mt-8 md:text-center">
    <div class="text-xs uppercase tracking-[0.15em] text-[var(--color-fg-dim)]">
      {dateFmt.format(post.data.date)} · {readingTime} {dict.blog.readingTime} · {post.data.tags.join(', ')}
    </div>
    <h1 class="mt-6 font-serif text-4xl leading-tight md:text-5xl">{post.data.title}</h1>
    {post.data.description && (
      <p class="mx-auto mt-4 max-w-2xl font-serif text-[var(--color-fg-muted)]">{post.data.description}</p>
    )}
  </header>
</div>

<!-- Divider + post body — narrower reading column -->
<article class="mx-auto max-w-2xl px-6 pb-12">
  <hr class="mt-10 border-t border-[var(--color-border)]" />

  <div class="prose-post mt-10">
    <Content />

    <!-- Byline card — CSS order places it before the references -->
    <div class="byline-card flex items-center gap-5 rounded-2xl border border-[var(--color-border)] bg-[var(--color-bg-soft)] p-6 my-10">
      <img
        src="/hecsanchez.png"
        alt="Hec Sánchez"
        width="64"
        height="64"
        class="h-16 w-16 shrink-0 rounded-full object-cover"
      />
      <div>
        <div class="text-sm font-medium text-[var(--color-fg)]">Hec Sánchez</div>
        <p class="mt-1 text-sm text-[var(--color-fg-muted)]">
          {locale === 'es'
            ? 'Escribo sobre ingeniería en industrias reguladas.'
            : 'I write about engineering in regulated industries.'}
        </p>
        <a
          href={authorLink}
          target="_blank"
          rel="noopener"
          class="mt-1 inline-block text-sm text-[var(--color-accent)] underline underline-offset-4"
        >
          {authorLinkLabel} →
        </a>
      </div>
    </div>
  </div>
</article>

<!-- Floating subscribe — slides in from right when byline is in view -->
<div
  id="floating-subscribe"
  class="fixed bottom-6 right-6 z-50 w-[340px] translate-x-[400px] transition-transform duration-500 ease-out"
>
  <div class="rounded-2xl border border-[var(--color-border)] bg-[var(--color-bg-soft)] p-5 shadow-lg">
    <button
      id="floating-close"
      type="button"
      class="absolute top-3 right-3 text-[var(--color-fg-dim)] hover:text-[var(--color-fg)]"
      aria-label="Close"
    >
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18M6 6l12 12"/></svg>
    </button>
    <h3 class="font-serif text-lg">{locale === 'es' ? 'Suscríbete' : 'Subscribe'}</h3>
    <p class="mt-1 text-sm text-[var(--color-fg-muted)]">
      {locale === 'es'
        ? 'Recibe nuevos artículos. Sin spam.'
        : 'Get new articles. No spam.'}
    </p>
    <form id="floating-form" class="mt-4 flex flex-col gap-2">
      <input
        type="email"
        name="email"
        required
        placeholder={locale === 'es' ? 'Tu email' : 'Your email'}
        class="rounded-lg border border-[var(--color-border)] bg-[var(--color-bg)] px-3 py-2 text-sm text-[var(--color-fg)] placeholder:text-[var(--color-fg-dim)] focus:border-[var(--color-accent)] focus:outline-none"
      />
      <button
        type="submit"
        class="rounded-full bg-[var(--color-accent)] px-4 py-2 text-sm font-medium text-[var(--color-bg)] transition hover:bg-[var(--color-accent-hover)]"
      >
        {locale === 'es' ? 'Suscribir' : 'Subscribe'}
      </button>
    </form>
    <!-- Loading -->
    <div id="floating-loading" class="mt-4 hidden flex items-center justify-center py-2">
      <svg class="animate-spin h-5 w-5 text-[var(--color-accent)]" viewBox="0 0 24 24" fill="none">
        <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2" opacity="0.25" />
        <path d="M4 12a8 8 0 018-8" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
      </svg>
    </div>
    <!-- Success -->
    <div id="floating-success" class="mt-4 hidden flex items-center gap-2 py-2">
      <div class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-[var(--color-accent)]">
        <svg class="h-3 w-3 text-[var(--color-bg)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 13l4 4L19 7"/></svg>
      </div>
      <span class="text-sm text-[var(--color-fg-muted)]">
        {locale === 'es' ? 'Listo — revisa tu email.' : 'Done — check your email.'}
      </span>
    </div>
    <!-- Error -->
    <p id="floating-error" class="mt-2 text-xs text-[var(--color-accent)] hidden"></p>
  </div>
</div>

<script is:inline>
  (function () {
    const container = document.getElementById('floating-subscribe');
    const closeBtn = document.getElementById('floating-close');
    const form = document.getElementById('floating-form');
    const loading = document.getElementById('floating-loading');
    const success = document.getElementById('floating-success');
    const error = document.getElementById('floating-error');
    const byline = document.querySelector('.byline-card');

    if (!container || !byline) return;

    let shown = false;
    let dismissed = false;

    // Show when byline scrolls into view
    const observer = new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting && !shown && !dismissed) {
          shown = true;
          container.classList.remove('translate-x-[400px]');
          container.classList.add('translate-x-0');
        }
      },
      { threshold: 0.3 }
    );
    observer.observe(byline);

    // Dismiss
    closeBtn.addEventListener('click', () => {
      dismissed = true;
      container.classList.remove('translate-x-0');
      container.classList.add('translate-x-[400px]');
    });

    // Submit
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const email = form.querySelector('input[name="email"]').value;

      form.classList.add('hidden');
      error.classList.add('hidden');
      loading.classList.remove('hidden');

      try {
        const res = await fetch('/api/subscribe', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email }),
        });
        const data = await res.json();

        loading.classList.add('hidden');
        if (data.ok) {
          success.classList.remove('hidden');
        } else {
          form.classList.remove('hidden');
          error.textContent = data.error || 'Something went wrong.';
          error.classList.remove('hidden');
        }
      } catch {
        loading.classList.add('hidden');
        form.classList.remove('hidden');
        error.textContent = 'Something went wrong.';
        error.classList.remove('hidden');
      }
    });
  })();
</script>
