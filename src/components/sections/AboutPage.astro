---
import { t, type Locale, contactInfo, careerTimeline } from '../../i18n';
import ArrowLink from '../ArrowLink.astro';
import AudienceCta from '../AudienceCta.astro';

interface Props { locale: Locale }
const { locale } = Astro.props;
const dict = t(locale);
const page = dict.about;
---

<section class="mx-auto max-w-3xl px-6 pt-20 pb-10">
  <h1 class="font-serif text-4xl md:text-5xl">{page.h1}</h1>
  <div class="mt-6 space-y-5">
    {page.intro.map((paragraph) => (
      <p class="font-serif leading-relaxed text-[var(--color-fg)]">{paragraph}</p>
    ))}
  </div>
</section>

<section class="mx-auto max-w-3xl px-6 py-10">
  <h2 class="font-serif text-3xl">{page.buildingTitle}</h2>
  {page.building.map((paragraph) => (
    <p class="mt-4 text-[var(--color-fg-muted)]">{paragraph}</p>
  ))}
  <p class="mt-6">
    <ArrowLink href={dict.routes.projects}>{dict.cta.exploreMyProjects}</ArrowLink>
  </p>
</section>

<section class="mx-auto max-w-3xl px-6 py-10">
  <h2 class="font-serif text-3xl">{page.approachTitle}</h2>
  {page.approach.map((paragraph) => (
    <p class="mt-4 text-[var(--color-fg-muted)]">{paragraph}</p>
  ))}
</section>

<section class="mx-auto max-w-3xl px-6 py-10">
  <h2 class="font-serif text-3xl">{page.writingTitle}</h2>
  {page.writing.map((paragraph) => (
    <p class="mt-4 text-[var(--color-fg-muted)]">{paragraph}</p>
  ))}
  <p class="mt-6">
    <ArrowLink href={dict.routes.blog}>{dict.cta.readMyWriting}</ArrowLink>
  </p>
</section>

<section class="mx-auto max-w-3xl px-6 py-10">
  <h2 class="text-xs uppercase tracking-[0.18em] text-[var(--color-fg-dim)]">{page.trajectoryTitle}</h2>
  <ol class="mt-8 divide-y divide-[var(--color-border)]">
    {careerTimeline.map((entry) => (
      <li class="grid gap-3 py-6 md:grid-cols-[1fr_auto] md:items-center md:gap-8">
        <div class="flex items-center gap-4">
          {entry.logo ? (
            <img
              src={`/logos/companies/${entry.logo}`}
              alt={`${entry.company[locale]} logo`}
              width="40"
              height="40"
              loading="lazy"
              decoding="async"
              class="h-10 w-10 shrink-0 rounded object-contain"
            />
          ) : (
            <div
              class="h-10 w-10 shrink-0 rounded border border-dashed border-[var(--color-border)] bg-[var(--color-bg-elevated)]"
              aria-hidden="true"
            />
          )}
          <span class="font-medium text-[var(--color-fg)]">{entry.company[locale]}</span>
        </div>
        <div class="md:text-right">
          <div class="text-[var(--color-fg)]">{entry.role[locale]}</div>
          <div class="mt-0.5 text-sm uppercase tracking-wider text-[var(--color-fg-dim)]">
            {entry.years[locale]}
          </div>
        </div>
      </li>
    ))}
  </ol>
</section>

<section class="mx-auto max-w-3xl px-6 py-10">
  <h2 class="text-xs uppercase tracking-[0.18em] text-[var(--color-fg-dim)]">{page.linksTitle}</h2>
  <ul class="mt-4 flex flex-wrap gap-5 text-[var(--color-fg)]">
    <li><a href={contactInfo.linkedin} target="_blank" rel="noopener" class="underline underline-offset-4">LinkedIn</a></li>
    <li><a href={contactInfo.github} target="_blank" rel="noopener" class="underline underline-offset-4">GitHub</a></li>
    <li>
      <a
        href={`mailto:${contactInfo.email}`}
        class="underline underline-offset-4"
        data-analytics-event="contact_email_click"
        data-analytics-props={JSON.stringify({ audience: 'none', locale })}
      >
        {contactInfo.email}
      </a>
    </li>
  </ul>
</section>

<div class="pb-10">
  <AudienceCta locale={locale} placement="about" title={page.workWithMeTitle} body={page.workWithMeBody} />
</div>
