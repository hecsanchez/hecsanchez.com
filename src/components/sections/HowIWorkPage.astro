---
import { t, type Locale } from '../../i18n';
import AudienceCta from '../AudienceCta.astro';
import ArrowLink from '../ArrowLink.astro';

interface Props { locale: Locale }
const { locale } = Astro.props;
const dict = t(locale);
const page = dict.howIWork;
---

<section class="mx-auto max-w-3xl px-6 pt-20 pb-10">
  <h1 class="font-serif text-4xl leading-tight text-balance md:text-5xl">{page.h1}</h1>
  <p class="mt-6 font-serif text-[var(--color-fg-muted)]">{page.intro}</p>
</section>

<section class="mx-auto max-w-3xl px-6 py-10">
  <h2 class="font-serif text-3xl">{page.waysTitle}</h2>
  <div class="mt-8 space-y-6">
    {page.ways.map((way) => (
      <article class="rounded-2xl border border-[var(--color-border)] bg-[var(--color-bg-soft)] p-7">
        <h3 class="font-serif text-xl">{way.title}</h3>
        <p class="mt-3 text-[var(--color-fg-muted)]">{way.body}</p>
      </article>
    ))}
  </div>
  <p class="mt-8">
    <ArrowLink href={dict.routes.fractionalCto}>{dict.nav.fractionalCto}</ArrowLink>
  </p>
</section>

<section class="mx-auto max-w-3xl px-6 py-10">
  <h2 class="font-serif text-3xl">{page.processTitle}</h2>
  <ol class="mt-8 space-y-8 border-l border-[var(--color-border)] pl-6">
    {page.process.map((item) => (
      <li class="relative">
        <span class="absolute -left-[31px] top-1 inline-flex h-4 w-4 rounded-full border-2 border-[var(--color-accent)] bg-[var(--color-bg)]" aria-hidden="true" />
        <div class="text-xs uppercase tracking-[0.18em] text-[var(--color-fg-dim)]">{item.step}</div>
        <p class="mt-1 text-[var(--color-fg-muted)]">
          <span class="font-medium text-[var(--color-fg)]">{item.label}</span>{' '}{item.body}
        </p>
      </li>
    ))}
  </ol>
</section>

<div class="pb-10">
  <AudienceCta locale={locale} placement="how_i_work" title={page.routeTitle} body={page.routeBody} />
</div>
