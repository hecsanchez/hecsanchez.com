---
import { t, type Locale, contactInfo } from '../i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;
const dict = t(locale);
const r = dict.routes;
const year = new Date().getFullYear();

const siteLinks = [
  { href: r.blog, label: dict.nav.blog },
  { href: r.projects, label: dict.nav.projects },
  { href: r.about, label: dict.nav.about },
  { href: r.rss, label: dict.footer.rss },
];

const workLinks = [
  { href: r.agencies, label: dict.nav.agencies },
  { href: r.founders, label: dict.nav.founders },
  { href: r.howIWork, label: dict.nav.howIWork },
  { href: r.fractionalCto, label: dict.nav.fractionalCto },
  { href: r.contact, label: dict.nav.contact },
];

const linkClass = 'hover:text-[var(--color-fg)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-accent)]';
---

<footer class="mt-24 border-t border-[var(--color-border)]">
  <div class="mx-auto max-w-5xl px-6 py-12 text-sm text-[var(--color-fg-dim)]">
    <div class="grid gap-8 sm:grid-cols-3">
      <nav aria-labelledby="footer-site">
        <h2 id="footer-site" class="text-xs uppercase tracking-[0.15em] text-[var(--color-fg-dim)]">
          {dict.footer.navTitle}
        </h2>
        <ul class="mt-4 space-y-2">
          {siteLinks.map((link) => (
            <li><a href={link.href} class={linkClass}>{link.label}</a></li>
          ))}
        </ul>
      </nav>

      <nav aria-labelledby="footer-work">
        <h2 id="footer-work" class="text-xs uppercase tracking-[0.15em] text-[var(--color-fg-dim)]">
          {dict.footer.workTitle}
        </h2>
        <ul class="mt-4 space-y-2">
          {workLinks.map((link) => (
            <li><a href={link.href} class={linkClass}>{link.label}</a></li>
          ))}
        </ul>
      </nav>

      <nav aria-labelledby="footer-elsewhere">
        <h2 id="footer-elsewhere" class="text-xs uppercase tracking-[0.15em] text-[var(--color-fg-dim)]">
          {dict.footer.elsewhereTitle}
        </h2>
        <ul class="mt-4 space-y-2">
          <li><a href={contactInfo.linkedin} target="_blank" rel="noopener" class={linkClass}>LinkedIn</a></li>
          <li><a href={contactInfo.github} target="_blank" rel="noopener" class={linkClass}>GitHub</a></li>
          <li>
            <a
              href={`mailto:${contactInfo.email}`}
              class={linkClass}
              data-analytics-event="contact_email_click"
              data-analytics-props={JSON.stringify({ audience: 'none', locale })}
            >
              {contactInfo.email}
            </a>
          </li>
        </ul>
      </nav>
    </div>

    <div class="mt-10 border-t border-[var(--color-border)] pt-6">
      © {year} Hec Sánchez. {dict.footer.rights}
    </div>
  </div>
</footer>
