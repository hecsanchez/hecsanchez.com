---
// Root landing page. Renders a real static fallback so `/` is useful with or
// without JavaScript, then hands visitors to their preferred language.
import '../styles/global.css';

const site = Astro.site;
const canonical = new URL('/', site).toString();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Hec Sánchez | Product Engineer & Fractional CTO</title>
    <meta
      name="description"
      content="Hec Sánchez builds software and helps agencies and founders make better technical decisions. Available in English and Spanish."
    />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/logos/hecsanchez.svg" />
    <link rel="preconnect" href="https://use.typekit.net" crossorigin />
    <link rel="stylesheet" href="https://use.typekit.net/ujh3wif.css" />
    <script is:inline>
      // Send visitors to the language they asked for. The page below stands on
      // its own if this never runs, and /en and /es stay directly reachable.
      try {
        const langs = (navigator.languages && navigator.languages.length
          ? navigator.languages
          : [navigator.language || 'en']).map((l) => l.toLowerCase());
        location.replace(langs.some((l) => l.startsWith('es')) ? '/es' : '/en');
      } catch {}
    </script>
  </head>
  <body class="flex min-h-dvh items-center justify-center px-6 py-20">
    <main class="max-w-xl text-center">
      <img
        src="/hecsanchez.png"
        alt="Hec Sánchez"
        width="240"
        height="240"
        class="mx-auto h-28 w-28 rounded-full object-cover"
      />
      <h1 class="mt-8 font-serif text-4xl">Hec Sánchez</h1>
      <p class="mt-4 text-[var(--color-fg-muted)]">
        Product engineer and fractional CTO based in Mexico. I build software and work with
        agencies and founders on product development, integrations, and technical leadership.
      </p>
      <p class="mt-8 flex flex-wrap justify-center gap-4">
        <a
          href="/en"
          class="inline-flex items-center gap-2 rounded-full bg-[var(--color-accent)] px-6 py-3 font-medium text-[var(--color-bg)] hover:text-[var(--color-bg)]"
        >
          English
        </a>
        <a
          href="/es"
          class="inline-flex items-center gap-2 rounded-full border border-[var(--color-border)] px-6 py-3 font-medium text-[var(--color-fg)]"
        >
          Español
        </a>
      </p>
    </main>
  </body>
</html>
