---
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BlogPostPage from '../../../components/sections/BlogPostPage.astro';

export async function getStaticPaths() {
  // Drafts get pages too (so the slug is reachable as a preview URL),
  // but BlogIndexPage and the RSS feed filter them out.
  const posts = await getCollection('blog', ({ data }) => data.locale === 'en');
  return posts.map((post) => ({
    params: { slug: post.id.replace(/\.mdx?$/, '') },
    props: { post },
  }));
}

const { post } = Astro.props;
const slug = post.id.replace(/\.mdx?$/, '');

// Only a post sharing this one's translationKey is a real equivalent. Without
// one, the switcher falls back to the other locale's Writing index rather than
// dropping the reader on a homepage — and no `hreflang` is claimed.
const counterpart = post.data.translationKey
  ? (await getCollection('blog', ({ data }) => data.locale === 'es' && !data.draft))
      .find(({ data }) => data.translationKey === post.data.translationKey)
  : undefined;
const altLocaleHref = counterpart
  ? `/es/escritos/${counterpart.id.replace(/\.mdx?$/, '')}`
  : undefined;
const ogImage = existsSync(join(process.cwd(), 'public', 'og', 'writing', `${slug}.png`))
  ? `/og/writing/${slug}.png`
  : undefined;
---
<BaseLayout
  locale="en"
  title={`${post.data.title} — Hec Sánchez`}
  description={post.data.description}
  altLocaleHref={altLocaleHref}
  altLocaleFallbackHref="/es/escritos"
  noindex={post.data.draft}
  type="article"
  ogImage={ogImage}
  articleDate={post.data.date}
  articleTags={post.data.tags}
  article={{
    headline: post.data.title,
    description: post.data.description,
    datePublished: post.data.date.toISOString(),
    image: ogImage ? new URL(ogImage, Astro.site).toString() : undefined,
  }}
>
  <BlogPostPage locale="en" post={post} />
</BaseLayout>
