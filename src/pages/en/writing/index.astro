---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BlogIndexPage from '../../../components/sections/BlogIndexPage.astro';
import { t } from '../../../i18n';

const dict = t('en');
const posts = (await getCollection('blog', ({ data }) => !data.draft && data.locale === 'en'))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const itemList = posts.map((post) => ({
  name: post.data.title,
  url: new URL(`${dict.routes.blog}/${post.id.replace(/\.mdx?$/, '')}/`, Astro.site).toString(),
}));
---
<BaseLayout
  locale="en"
  title={dict.blog.metaTitle}
  description={dict.blog.metaDescription}
  altLocaleHref="/es/escritos"
  pageType="CollectionPage"
  itemList={itemList}
>
  <BlogIndexPage locale="en" />
</BaseLayout>
