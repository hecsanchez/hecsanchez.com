---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FoundersPage from '../../components/sections/FoundersPage.astro';
import { t } from '../../i18n';
const dict = t('en');
---
<BaseLayout
  locale="en"
  title={dict.founders.metaTitle}
  description={dict.founders.metaDescription}
  altLocaleHref="/es/para-fundadores"
  service={{ name: dict.founders.serviceName, description: dict.founders.metaDescription }}
>
  <FoundersPage locale="en" />
</BaseLayout>
