---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ProjectDetailPage from '../../../components/sections/ProjectDetailPage.astro';
import { publishedProjects, type Project } from '../../../data/projects';
import { resolveProjectImage } from '../../../lib/projectImages';

export async function getStaticPaths() {
  return publishedProjects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props as { project: Project };

// Use the project's own hero as the social card when the screenshot exists.
const ogImage = resolveProjectImage(project.hero?.file)?.src;
---
<BaseLayout
  locale="en"
  title={`${project.title.en} | Hec Sánchez`}
  description={project.cardDescription.en}
  altLocaleHref={`/es/proyectos/${project.id}`}
  ogImage={ogImage}
>
  <ProjectDetailPage locale="en" project={project} />
</BaseLayout>
