---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AgenciesPage from '../../components/sections/AgenciesPage.astro';
import { t } from '../../i18n';
const dict = t('en');
---
<BaseLayout
  locale="en"
  title={dict.agencies.metaTitle}
  description={dict.agencies.metaDescription}
  altLocaleHref="/es/para-agencias"
  service={{ name: dict.agencies.serviceName, description: dict.agencies.metaDescription }}
>
  <AgenciesPage locale="en" />
</BaseLayout>
