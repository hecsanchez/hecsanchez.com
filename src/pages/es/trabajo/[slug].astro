---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ProjectDetailPage from '../../../components/sections/ProjectDetailPage.astro';
import { t } from '../../../i18n';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const dict = t('es');
const title = `${project.data.name} — ${dict.siteName}`;
---
<BaseLayout
  locale="es"
  title={title}
  description={project.data.summary.es}
  altLocaleHref={`/en/work/${project.id}`}
>
  <ProjectDetailPage locale="es" project={project} />
</BaseLayout>
